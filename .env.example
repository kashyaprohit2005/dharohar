# Dharohar Monorepo Environment Variables Reference

# ─────────────────────────────────────────────────────────────
# BACKEND (Render Web Service: dharohar-backend)
# ─────────────────────────────────────────────────────────────
PORT=8000
ENVIRONMENT=production
DATABASE_URL=sqlite:///./craftproof.db
SECRET_KEY=generate-a-secure-32-character-secret-key
FRONTEND_URL=https://dharohar.onrender.com
ALLOWED_ORIGINS=https://dharohar.onrender.com,http://localhost:3000

# ─────────────────────────────────────────────────────────────
# FRONTEND (Render Web Service: dharohar-frontend)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=https://dharohar-backend.onrender.com
PORT=3000
NODE_ENV=production
