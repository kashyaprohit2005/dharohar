# Dharohar Backend Environment Configuration
# Copy this file to .env and configure your values

# Database Connection (Defaults to local SQLite for prototype, upgrade to PostgreSQL for production)
DATABASE_URL=sqlite:///./craftproof.db
# Example PostgreSQL for Render:
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# Security & Authentication
SECRET_KEY=change-this-to-a-secure-random-string-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server Binding
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# CORS Configuration (Comma-separated list of allowed frontend URLs)
FRONTEND_URL=https://dharohar.onrender.com
ALLOWED_ORIGINS=https://dharohar.onrender.com,http://localhost:3000,http://127.0.0.1:3000
